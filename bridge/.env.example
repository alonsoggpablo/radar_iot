# Identidad del emplazamiento y del sensor
RADAR_SITE=concejo_oviedo_paso_independencia_3
RADAR_SENSOR_ID=radar_iot_001

# Política operativa
RADAR_SPEED_LIMIT_KMH=30
RADAR_HIGHWAY_SCENARIO=false
RADAR_RETENTION_DAYS=90

# Broker AGlabs — WSS por 443 mientras el listener 8883 no esté expuesto
MQTT_HOST=mqtt.aglabs.es
MQTT_PORT=443
MQTT_TRANSPORT=websockets
MQTT_PATH=/mqtt
MQTT_TLS=true
MQTT_USERNAME=radar_iot_001
MQTT_PASSWORD=changeme
MQTT_TOPIC_BASE=aglabs/radar

# Tuning
HEARTBEAT_INTERVAL_S=60
PUBLISH_RETRY_INTERVAL_S=5
TAIL_POLL_MS=100
LOG_LEVEL=INFO
